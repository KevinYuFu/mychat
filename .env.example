# Copy this file to .env and fill in your values. .env is git-ignored.

# Get a key at https://openrouter.ai/keys (sign up, add a little credit).
OPENROUTER_API_KEY=

# Model slug from https://openrouter.ai/models
# Default is an uncensored fine-tune (Dolphin-Mistral 24B).
MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition

# OpenAI-compatible base URL. Point this at Ollama/vLLM/etc. to swap the LLM.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional default system prompt (sets the persona: roleplay, assistant, ...).
# A per-request system prompt overrides this.
# SYSTEM_PROMPT=

# Port the backend listens on.
PORT=8787
